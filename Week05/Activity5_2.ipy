
sentence = input("Enter a sentence: ")

words = sentence.lower().split()

word_counts = {}


for word in words:
    
    clean_word = word.strip('.,!?"')

    if clean_word:
        if clean_word in word_counts:
            word_counts[clean_word] += 1
        else:
            word_counts[clean_word] = 1

print("\n--- Word Frequency Count ---")
for word, count in word_counts.items():
    print(f"'{word}': {count}")