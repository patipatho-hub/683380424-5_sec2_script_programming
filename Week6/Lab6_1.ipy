def add(a, b):
    return a + b

def subtract(a, b):
    return a - b

def multiply(a, b):
    return a * b


def divide(a, b):
    if b == 0:
        return "Error: Division by zero"
    return a / b


def power(base, exponent=2):
    return base**exponent


def main():
    while True:
        print("\n=== Simple Calculator Menu ===")
        print("1. Add")
        print("2. Subtract")
        print("3. Multiply")
        print("4. Divide")
        print("5. Power (Exponentation)")
        print("6. Exit")

        choice = input("Enter choice (1-6): ").strip()

        if choice == "6":
            print("Exiting calculator. Goodbye!")
            break

        if choice in ("1", "2", "3", "4"):
            try:
                num1 = float(input("Enter first number: "))
                num2 = float(input("Enter second number: "))
            except ValueError:
                print("Invalid input! Please enter valid numbers.")
                continue

            if choice == "1":
                result = add(num1, num2)
            elif choice == "2":
                result = subtract(num1, num2)
            elif choice == "3":
                result = multiply(num1, num2)
            elif choice == "4":
                result = divide(num1, num2)

            print(f"Result: {result}")

        elif choice == "5":
            try:
                base = float(input("Enter base number: "))
                exp_input = input("Enter exponent (press Enter to default to 2): ").strip()
                if exp_input == "":
                    result = power(base)
                else:
                    result = power(base, float(exp_input))
                print(f"Result: {result}")
            except ValueError:
                print("Invalid input! Please enter valid numbers.")

        else:
            print("Invalid choice. Please choose an option between 1 and 6.")


if __name__ == "__main__":
    main()
